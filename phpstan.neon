includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/xefi/phpstan-xefi-rules/extension.neon

parameters:
    paths:
        - app
        - database
        - layers
        - routes

    excludePaths:
        # Published by spatie/laravel-permission, not application code.
        - database/migrations/*_create_permission_tables.php

    level: 5

    # Larastan infers model properties from the migrations; a layer keeps its own.
    databaseMigrationsPath:
        - database/migrations
        - layers/tickets/database/migrations

    # faker() reaches its generators through __call; this declares the ones used.
    stubFiles:
        - phpstan/faker.stub
