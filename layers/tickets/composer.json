{
    "name": "layers/tickets",
    "description": "Domaine ticketing",
    "type": "layer",
    "version": "1.0.0",
    "require": {
        "xefi/laravel-osdd": "*"
    },
    "autoload": {
        "psr-4": {
            "Tickets\\": "src/",
            "Tickets\\Database\\Seeders\\": "database/seeders/",
            "Tickets\\Database\\Factories\\": "database/factories/",
            "Tickets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tickets\\Providers\\TicketsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
